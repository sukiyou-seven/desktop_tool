<Page
    x:Class="DesktopTool.Pages.ProjectManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DesktopTool.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Page.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">


    

    <Grid Padding="24,16,24,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 进度条 -->
        <Border x:Name="ProgressBorder" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14">
            <StackPanel Spacing="8">
                <TextBlock x:Name="ProgressText" Text="准备中..." />
                <ProgressBar IsIndeterminate="True" />
            </StackPanel>
        </Border>

        <!-- 标题栏 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="工程管理" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="创建 / 添加已有目录 / 每张工程卡片可直接执行 npm 命令" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="AddProjectBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="添加工程" />
                    </StackPanel>
                </Button>
                <Button Click="NewProjectBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="新建工程" />
                    </StackPanel>
                </Button>
                <Button Click="MyProjectBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7C3;" FontSize="14" />
                        <TextBlock Text="我的专属工程" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 工程列表（卡片内嵌 npm 执行） -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="ProjectList" ItemsSource="{x:Bind Projects, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="380" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ProjectCardVm">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="{x:Bind TypeIcon}" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border CornerRadius="4" Padding="6,1" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                <TextBlock Text="{x:Bind Type}" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Framework}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />

                                <!-- 针对本工程的 npm 执行区 -->
                                <Grid ColumnSpacing="6" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Text="{x:Bind NpmDir, Mode=TwoWay}"
                                        IsReadOnly="True"
                                        FontSize="12"
                                        PlaceholderText="工作目录"
                                        TextWrapping="NoWrap" />
                                    <Button Grid.Column="1" Content="选目录" Click="CardPickDirBtn_Click" Tag="{Binding}" Padding="10,3" FontSize="12" />
                                </Grid>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        ItemsSource="{x:Bind NpmCommands}"
                                        SelectedItem="{x:Bind SelectedNpmCommand, Mode=TwoWay}"
                                        PlaceholderText="npm 命令"
                                        FontSize="12"
                                        SelectionChanged="CardNpmCommandChanged"
                                        Tag="{Binding}"
                                        HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="执行" Click="CardRunNpmBtn_Click" Tag="{Binding}" Style="{StaticResource AccentButtonStyle}" Padding="10,3" FontSize="12" />
                                </Grid>
                                <TextBlock
                                    Text="{x:Bind NpmStatus}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    Text="{x:Bind Output}"
                                    IsReadOnly="True"
                                    Height="96"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    TextChanged="CardOutputTextChanged" />

                                <!-- 上传到服务器（复用「服务器管理」的服务器） -->
                                <TextBlock Text="上传到服务器" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                                <ComboBox
                                    ItemsSource="{x:Bind ServerLinks}"
                                    SelectedItem="{x:Bind SelectedServerLink, Mode=TwoWay}"
                                    DisplayMemberPath="Name"
                                    PlaceholderText="选择服务器（服务器管理）"
                                    FontSize="12"
                                    SelectionChanged="CardServerChanged"
                                    Tag="{Binding}"
                                    HorizontalAlignment="Stretch" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        Text="{x:Bind LocalUploadPath, Mode=TwoWay}"
                                        IsReadOnly="True"
                                        FontSize="12"
                                        PlaceholderText="本地目录 / 文件" />
                                    <Button Grid.Column="1" Content="目录" Click="CardPickLocalDirBtn_Click" Tag="{Binding}" Padding="8,3" FontSize="12" />
                                    <Button Grid.Column="2" Content="文件" Click="CardPickLocalFileBtn_Click" Tag="{Binding}" Padding="8,3" FontSize="12" />
                                </Grid>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        Text="{x:Bind RemoteUploadDir, Mode=TwoWay}"
                                        FontSize="12"
                                        PlaceholderText="服务器目录，如 /www/wwwroot/app" />
                                    <Button Grid.Column="1" Content="浏览" Click="CardBrowseRemoteBtn_Click" Tag="{Binding}" Padding="10,3" FontSize="12" />
                                </Grid>
                                <Expander HorizontalAlignment="Stretch" IsExpanded="False">
                                    <Expander.Header>
                                        <TextBlock Text="排除规则（运行时产物自动排除已默认开启）" FontSize="12" />
                                    </Expander.Header>
                                    <StackPanel Spacing="6" Padding="0,6">
                                        <CheckBox Content="自动排除运行时产物（node_modules、.venv、__pycache__、.git、.idea、dist、build、obj、bin、target、*.pyc、*.log、.DS_Store 等）" IsChecked="{x:Bind AutoExclude, Mode=TwoWay}" FontSize="12" />
                                        <TextBox
                                            Text="{x:Bind CustomExcludesText, Mode=TwoWay}"
                                            PlaceholderText="自定义排除（每行一个，支持 * ?）：&#x0a;.env&#x0a;*.zip&#x0a;temp_files"
                                            Height="64"
                                            FontSize="12"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                                <Button Content="上传" Click="CardRunUploadBtn_Click" Tag="{Binding}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                                <ProgressBar Maximum="100" Value="{x:Bind UploadPercent, Mode=OneWay}" Visibility="{x:Bind UploadBusy}" />
                                <TextBlock
                                    Text="{x:Bind UploadStatus}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    Text="{x:Bind UploadLog}"
                                    IsReadOnly="True"
                                    Height="72"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    TextChanged="CardUploadLogChanged" />

                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                    <Button Content="打开目录" Tag="{Binding}" Click="OpenFolderBtn_Click" Padding="10,4" FontSize="12" />
                                    <Button Content="删除" Tag="{Binding}" Click="DeleteProjectBtn_Click" Padding="10,4" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 空状态 -->
        <Border Grid.Row="1" x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8A7;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="还没有工程，点击右上角添加或新建" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>

    </ScrollViewer>
</Page>
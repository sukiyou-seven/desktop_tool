<?xml version="1.0" encoding="utf-8" ?>
<StackPanel
    x:Class="DesktopTool.Pages.ServerDirBrowserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="500"
    Spacing="8"
    mc:Ignorable="d">

    <TextBlock x:Name="PathText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
    <TextBox x:Name="PathBox" PlaceholderText="也可以直接输入路径后回车" FontSize="12" KeyDown="PathBox_KeyDown" />
    <ListView x:Name="DirList" Height="260" SelectionMode="None" IsItemClickEnabled="True" ItemsSource="{x:Bind SubDirs, Mode=OneWay}" ItemClick="DirList_ItemClick">
        <ListView.ItemTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
    <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="上级目录" Click="UpBtn_Click" Padding="10,4" FontSize="12" />
        <TextBlock Text="单击目录可进入，或在上方直接输入路径后回车" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
    </StackPanel>
</StackPanel>

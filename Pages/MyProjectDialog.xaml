<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DesktopTool.Pages.MyProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer MaxHeight="600">
        <StackPanel Spacing="14" MinWidth="560" Padding="0,4">
            <!-- 基本信息 -->
            <TextBlock Text="基本信息" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox x:Name="NameBox" Header="项目名称" PlaceholderText="myproject" />
            <StackPanel Spacing="4">
                <TextBox x:Name="RootDirBox" Header="根目录" PlaceholderText="选择父目录" IsReadOnly="True" />
                <Button Content="浏览…" HorizontalAlignment="Left" Click="DirBtn_Click" />
            </StackPanel>

            <!-- app.yml -->
            <TextBlock Text="app.yml — MongoDB" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="MongoIpBox" Header="数据库 IP" Text="localhost" />
                <TextBox Grid.Column="1" x:Name="MongoPortBox" Header="数据库端口" Text="27017" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="MongoDbBox" Header="数据库名称" />
                <TextBox Grid.Column="1" x:Name="MongoPwdBox" Header="数据库密码" />
            </Grid>

            <TextBlock Text="app.yml — Redis" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="RedisIpBox" Header="Redis IP" />
                <TextBox Grid.Column="1" x:Name="RedisPortBox" Header="Redis 端口" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="RedisPwdBox" Header="Redis 密码" />
                <TextBox Grid.Column="1" x:Name="RedisDbBox" Header="Redis 库 (1-16)" />
                <TextBox Grid.Column="2" x:Name="RedisExpireBox" Header="过期时间" Text="25920000" />
            </Grid>

            <!-- apifox.yml -->
            <TextBlock Text="apifox.yml" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="AfProjectBox" Header="AF 项目 ID" />
                <TextBox Grid.Column="1" x:Name="AfTokenBox" Header="AF Token" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="AfFolderBox" Header="AF 文件夹 ID" />
                <TextBox Grid.Column="1" x:Name="AfModelBox" Header="AF 模型 ID" />
            </Grid>

            <!-- 进度 -->
            <Border x:Name="ProgressPanel" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ProgressText" Text="准备中..." />
                    <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

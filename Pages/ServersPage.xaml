<Page
    x:Class="DesktopTool.Pages.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">


    <Grid Padding="16" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：服务器列表 -->
        <Grid Grid.Column="0" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="添加服务器" Click="AddServerBtn_Click" HorizontalAlignment="Stretch" />

            <ListView
                x:Name="ServerListView"
                Grid.Row="1"
                SelectionChanged="ServerListView_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="6" Spacing="2">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock
                                Text="{Binding Host}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 右侧：详情 -->
        <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <TextBlock
                    x:Name="ServerTitleText"
                    Text="未选择服务器"
                    Style="{StaticResource TitleTextBlockStyle}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="ConnStatusText"
                    Text=""
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <AppBarButton
                    x:Name="RefreshBtn"
                    Label="刷新"
                    Click="RefreshBtn_Click"
                    IsEnabled="False">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Refresh" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="DeleteServerBtn"
                    Label="删除"
                    Click="DeleteServerBtn_Click"
                    IsEnabled="False">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Delete" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </StackPanel>

            <SelectorBar
                x:Name="DetailTabs"
                Grid.Row="1"
                SelectionChanged="DetailTabs_SelectionChanged"
                IsEnabled="False">
                <SelectorBarItem Text="概览" Tag="overview" />
                <SelectorBarItem Text="终端" Tag="terminal" />
                <SelectorBarItem Text="文件" Tag="files" />
                <SelectorBarItem Text="数据库" Tag="database" />
            </SelectorBar>

            <!-- 概览 -->
            <Grid x:Name="OverviewPanel" Grid.Row="2" Visibility="Collapsed">
                <ScrollViewer>
                    <StackPanel Spacing="14" Padding="4">
                        <!-- 系统信息卡片 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="系统信息" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <Grid ColumnSpacing="24" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="主机名" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StatHostname" Text="-" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="运行时间" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" x:Name="StatUptime" Text="-" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="操作系统" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StatOs" Text="-" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="内核" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="StatKernel" Text="-" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CPU / 内存 -->
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="CPU" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="StatCpuModel" Text="-" TextWrapping="Wrap" />
                                    <TextBlock x:Name="StatCpuCores" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="使用率" />
                                        <TextBlock x:Name="StatCpuUsage" Text="-" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="内存" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="StatMemTotal" Text="-" />
                                    <TextBlock x:Name="StatMemUsed" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="使用率" />
                                        <TextBlock x:Name="StatMemUsage" Text="-" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 磁盘 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="磁盘" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ListView x:Name="DiskListView" Height="160">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="16" Padding="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Filesystem}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Size}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Used}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Avail}" />
                                                <TextBlock Grid.Column="4" Text="{Binding UsePercent}" />
                                                <TextBlock Grid.Column="5" Text="{Binding Mount}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- 网络 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="网络" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ListView x:Name="NetListView" Height="110">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="16" Padding="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Interface}" />
                                                <TextBlock Grid.Column="1" Text="{Binding IpAddress}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- 进程 Top -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="CPU 占用 Top 进程" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ListView x:Name="ProcListView" Height="220">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="16" Padding="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Pid}" />
                                                <TextBlock Grid.Column="1" Text="{Binding CpuPercent}" />
                                                <TextBlock Grid.Column="2" Text="{Binding MemPercent}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Command}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 终端 -->
            <Grid x:Name="TerminalPanel" Grid.Row="2" Visibility="Collapsed" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="TerminalOutput"
                    Grid.Row="0"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    FontFamily="Consolas"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        x:Name="CommandInput"
                        PlaceholderText="输入命令后回车执行，例如：ls -la /"
                        KeyDown="CommandInput_KeyDown" />
                    <Button Grid.Column="1" Content="执行" Click="RunCommandBtn_Click" />
                    <Button Grid.Column="2" Content="清空" Click="ClearTerminalBtn_Click" />
                </Grid>
            </Grid>

            <!-- 文件 -->
            <Grid x:Name="FilesPanel" Grid.Row="2" Visibility="Collapsed" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="上级目录" Click="ParentDirBtn_Click" />
                    <TextBox
                        x:Name="PathBox"
                        PlaceholderText="/"
                        KeyDown="PathBox_KeyDown"
                        Width="360" />
                    <Button Content="跳转" Click="GoPathBtn_Click" />
                    <Button Content="上传文件" Click="UploadFileBtn_Click" />
                    <Button Content="新建文件夹" Click="NewFolderBtn_Click" />
                </StackPanel>
                <ListView
                    x:Name="FileListView"
                    Grid.Row="1"
                    DoubleTapped="FileListView_DoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Padding="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="{Binding Glyph}"
                                    FontSize="16"
                                    VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Modified}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 数据库 -->
            <Grid x:Name="DatabasePanel" Grid.Row="2" Visibility="Collapsed" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 类型选择 + 状态 + 操作 -->
                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="数据库类型" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" x:Name="DbTypePanel">
                                <ToggleButton Content="MySQL" Tag="MySql" Click="DbTypeBtn_Click" CornerRadius="14,0,0,14" Padding="12,4" />
                                <ToggleButton Content="Redis" Tag="Redis" Click="DbTypeBtn_Click" CornerRadius="0" Padding="12,4" BorderThickness="1,1,0,1" />
                                <ToggleButton Content="MongoDB" Tag="MongoDB" Click="DbTypeBtn_Click" CornerRadius="0" Padding="12,4" BorderThickness="1,1,0,1" />
                                <ToggleButton Content="PostgreSQL" Tag="PostgreSQL" Click="DbTypeBtn_Click" CornerRadius="0" Padding="12,4" BorderThickness="1,1,0,1" />
                                <ToggleButton Content="SQLite" Tag="SQLite" Click="DbTypeBtn_Click" CornerRadius="0,14,14,0" Padding="12,4" BorderThickness="1,1,0,1" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="状态" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" x:Name="DbStatusText" Text="-" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Content="检测" Click="DbDetectBtn_Click" />
                            <Button Grid.Column="5" Content="连接测试" Click="DbTestConnBtn_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="DbInstallBtn" Content="安装" Click="DbInstallBtn_Click" />
                            <Button x:Name="DbUninstallBtn" Content="卸载" Click="DbUninstallBtn_Click" />
                            <Button x:Name="DbStartBtn" Content="启动" Click="DbStartBtn_Click" />
                            <Button x:Name="DbStopBtn" Content="停止" Click="DbStopBtn_Click" />
                            <Button x:Name="DbRestartBtn" Content="重启" Click="DbRestartBtn_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 连接参数 -->
                <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="已保存配置" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="DbConnCombo" PlaceholderText="选择已保存配置" Width="400" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectionChanged="DbConnCombo_SelectionChanged" />
                            <Button Grid.Column="2" Content="保存当前" Click="DbConnSaveBtn_Click" />
                            <Button Grid.Column="3" Content="删除" Click="DbConnDeleteBtn_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="DbHostBox" PlaceholderText="主机" Text="127.0.0.1" Width="140" />
                            <Button Content="探测" Click="DbDetectHostBtn_Click" ToolTipService.ToolTip="自动识别 WSL2 等环境的主机 IP" />
                            <TextBox x:Name="DbPortBox" PlaceholderText="端口" Width="80" />
                            <TextBox x:Name="DbUserBox" PlaceholderText="用户名" Width="120" />
                            <PasswordBox x:Name="DbPassBox" PlaceholderText="密码（可空）" Width="140" />
                            <TextBox x:Name="DbAuthSourceBox" PlaceholderText="认证库" Text="admin" Width="100" />
                            <Button Content="刷新库列表" Click="DbRefreshBtn_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 数据库列表 + 操作 -->
                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="数据库列表" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ListView x:Name="DbListView" Height="320" SelectionChanged="DbListView_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8" Padding="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Detail}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="操作" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBox x:Name="DbNewNameBox" PlaceholderText="新数据库名称" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="新建数据库" Click="DbCreateBtn_Click" />
                                <Button Content="删除选中" Click="DbDropBtn_Click" />
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <TextBlock Text="用户管理（用上方连接参数的管理员权限操作）" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="DbUserTargetText" Text="当前库：未选择" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" />
                            <ComboBox x:Name="DbChangeUserBox" PlaceholderText="选择或输入改密用户名" IsEditable="True" Width="220" />
                            <PasswordBox x:Name="DbNewPassBox" PlaceholderText="新密码" />
                            <Button Content="修改密码" Click="DbChangePassBtn_Click" HorizontalAlignment="Left" />
                            <TextBox
                                x:Name="DbResultText"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                Height="80"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

    </ScrollViewer>
</Page>
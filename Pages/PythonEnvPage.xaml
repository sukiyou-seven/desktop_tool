<Page
    x:Class="DesktopTool.Pages.PythonEnvPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DesktopTool.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="CardCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="InfoRowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">


    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="24,16,24,0" Spacing="2">
            <TextBlock Text="Python 环境" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="本机的 Python 解释器、工具链与虚拟环境" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <SelectorBar
            Grid.Row="1"
            Margin="24,14,24,0"
            x:Name="PageSelectorBar"
            SelectionChanged="PageSelectorBar_SelectionChanged">
            <SelectorBarItem Text="概览" Tag="overview" IsSelected="True" />
            <SelectorBarItem Text="解释器" Tag="interpreter" />
            <SelectorBarItem Text="工具链" Tag="toolchain" />
            <SelectorBarItem Text="Conda 环境" Tag="conda" />
            <SelectorBarItem Text="PATH" Tag="path" />
        </SelectorBar>

        <Grid Grid.Row="2" Margin="24,12,24,16">
            <!-- 概览 -->
            <ScrollViewer x:Name="OverviewPanel">
                <StackPanel Spacing="16" Padding="0,8,0,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Python" Style="{StaticResource CardCaptionStyle}" />
                                <TextBlock x:Name="PythonVersionText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="PythonPathText" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="pip" Style="{StaticResource CardCaptionStyle}" />
                                <TextBlock x:Name="PipVersionText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="PipPathText" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="uv" Style="{StaticResource CardCaptionStyle}" />
                                <TextBlock x:Name="UvVersionText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="UvPathText" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="conda" Style="{StaticResource CardCaptionStyle}" />
                                <TextBlock x:Name="CondaVersionText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="CondaEnvText" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 环境变量 -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="一键设置环境变量" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="PathEnvCombo" PlaceholderText="选择一个环境" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="1">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock Text="{Binding Version}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="设置 PATH" Click="SetPathBtn_Click" />
                                <Button Grid.Column="2" Content="移除 PATH" Click="RemovePathBtn_Click" />
                            </Grid>
                            <TextBlock x:Name="PathStatusText" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 解释器 -->
            <ScrollViewer x:Name="InterpreterPanel" Visibility="Collapsed">
                <StackPanel Spacing="10" Padding="0,8,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AddCustomBtn" Click="AddCustomBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="添加解释器" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NewEnvBtn" Click="NewEnvBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7C3;" FontSize="14" />
                                <TextBlock Text="新建环境" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock
                        Text="手动指定 python.exe；需要下载安装 Python / uv / Conda 请到「工具链」页签"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ItemsControl x:Name="EnvList" ItemsSource="{x:Bind Environments, Mode=OneWay}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <Border Style="{StaticResource BadgeStyle}" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Version}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{Binding AddedAtText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="管理包" VerticalAlignment="Center" Tag="{Binding}" Click="ManagePackagesBtn_Click" />
                                        <Button Grid.Column="2" Content="删除" VerticalAlignment="Center" Tag="{Binding}" Click="DeleteEnvBtn_Click" Visibility="{Binding DeleteButtonVisibility}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 工具链 -->
            <ScrollViewer x:Name="ToolchainPanel" Visibility="Collapsed">
                <StackPanel Spacing="8" Padding="0,8,0,8">
                    <ItemsControl ItemsSource="{x:Bind ToolItems, Mode=OneWay}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Style="{StaticResource InfoRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource InfoLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <Button
                                        Grid.Column="2"
                                        Content="{Binding ActionText}"
                                        Tag="{Binding ActionTag}"
                                        Click="ToolchainActionBtn_Click"
                                        Visibility="{Binding ActionVisibility}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Text="下载安装的 Python / uv / Conda 均为用户级安装，不修改系统 PATH"
                        Style="{StaticResource CardCaptionStyle}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Conda 环境 -->
            <ScrollViewer x:Name="CondaPanel" Visibility="Collapsed">
                <StackPanel Padding="0,8,0,8">
                    <ItemsControl ItemsSource="{x:Bind CondaEnvItems, Mode=OneWay}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Style="{StaticResource InfoRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource InfoLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- PATH -->
            <ScrollViewer x:Name="PathPanel" Visibility="Collapsed">
                <StackPanel Padding="0,8,0,8">
                    <ItemsControl ItemsSource="{x:Bind PathItems, Mode=OneWay}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Style="{StaticResource InfoRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource InfoLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 加载指示 -->
        <ProgressRing
            x:Name="LoadingRing"
            Width="48" Height="48"
            IsActive="False"
            HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- 新建虚拟环境对话框 -->
        <ContentDialog
            x:Name="NewEnvDialog"
            Title="新建 Python 虚拟环境"
            PrimaryButtonText="创建"
            CloseButtonText="取消"
            DefaultButton="Primary"
            PrimaryButtonClick="NewEnvDialog_PrimaryButtonClick">
            <StackPanel Spacing="14" MinWidth="440">
                <StackPanel Spacing="6">
                    <TextBlock Text="基解释器" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="NewEnvBaseCombo" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" />
                                        <TextBlock
                                            Text="{Binding Path}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="浏览…" Click="NewEnvBrowseBase_Click" />
                    </Grid>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="父目录（将用环境名称新建文件夹并创建虚拟环境）" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewEnvDirBox" PlaceholderText="如 D:\envs" />
                        <Button Grid.Column="1" Content="浏览…" Click="NewEnvBrowseDir_Click" />
                    </Grid>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="环境名称（将作为子文件夹名）" />
                    <TextBox x:Name="NewEnvNameBox" PlaceholderText=".seraphineVenv" />
                </StackPanel>
                <StackPanel x:Name="NewEnvProgressPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <ProgressRing Width="18" Height="18" IsActive="True" />
                    <TextBlock
                        x:Name="NewEnvStatusText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    x:Name="NewEnvHintText"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </ContentDialog>
    </Grid>

    </ScrollViewer>
</Page>
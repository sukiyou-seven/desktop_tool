<Page
    x:Class="DesktopTool.Pages.DownloadCondaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DesktopTool.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">


    <Grid Padding="24,16,24,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 返回 + 说明 -->
        <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="BackBtn"
                    Click="BackBtn_Click"
                    Padding="10,6"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="返回 Python 环境">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Text="下载安装 Conda" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock
                Text="通过官方 Miniconda 安装器安装：用户级、不加入系统 PATH、不注册为默认 Python"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 安装卡片 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <Border
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="44" Height="44"
                            CornerRadius="8"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE770;" FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Miniconda3 (64-bit)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Border
                                    x:Name="InstalledBadgeBorder"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed">
                                    <TextBlock Text="已安装" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="CondaVersionText" Text="检测中…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="InstallDirText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="InstallBtn" Content="下载安装" Click="InstallBtn_Click" />
                            <Button x:Name="UninstallBtn" Content="卸载" Click="UninstallBtn_Click" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="安装说明" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="· 下载官方 Miniconda3 安装器（约 90MB）并静默安装到 %LOCALAPPDATA%\\miniconda3&#10;· 用户级安装，不修改系统 PATH、不注册为默认 Python&#10;· 安装完成后可通过本工具管理 conda 环境，也可手动把 \\Scripts 加入 PATH 使用 conda 命令"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 日志 -->
        <TextBox
            x:Name="LogBox"
            Grid.Row="2"
            IsReadOnly="True"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            Height="150"
            FontFamily="Consolas"
            FontSize="12"
            BorderThickness="1" />
    </Grid>

    </ScrollViewer>
</Page>
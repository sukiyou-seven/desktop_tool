<Page
    x:Class="DesktopTool.Pages.DownloadComposerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DesktopTool.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">


    <Grid Padding="24,16,24,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 返回 + 说明 -->
        <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="BackBtn"
                    Click="BackBtn_Click"
                    Padding="10,6"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="返回 PHP 环境">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Text="下载安装 Composer" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock
                Text="从 getcomposer.org 官方源下载 composer.phar，存放到本工具托管目录。使用方式：php composer.phar &lt;命令&gt;"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 状态 + 操作 -->
        <StackPanel Grid.Row="1" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="当前：" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" VerticalAlignment="Center" />
                <Button x:Name="InstallBtn" Content="安装" Click="InstallBtn_Click" />
                <Button x:Name="UninstallBtn" Content="卸载" Click="UninstallBtn_Click" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>

        <!-- 日志 -->
        <TextBox
            x:Name="LogBox"
            Grid.Row="3"
            IsReadOnly="True"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            MinHeight="200"
            FontFamily="Consolas"
            FontSize="12"
            BorderThickness="1" />
    </Grid>

    </ScrollViewer>
</Page>
<Page
    x:Class="DesktopTool.Pages.ProxyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <SolidColorBrush x:Key="ProxyInfoBrush" Color="#7A7A7A" />
        <SolidColorBrush x:Key="ProxyOkBrush" Color="#0F7B0F" />
        <SolidColorBrush x:Key="ProxyErrorBrush" Color="#D13438" />
    </Page.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">


    

    <ScrollViewer>
        <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 说明 -->
        <StackPanel Spacing="4">
            <TextBlock Text="网络代理" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="一键把本机网络流量通过你的服务器代理出口转发（类似 VPN）。本地启动 HTTP 代理并自动设置系统代理，浏览器等应用即可生效；支持 TLS 加密，对接服务器端 gost（SOCKS5）。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 配置卡片 -->
        <Border
            Grid.Row="1"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ServerBox" Header="服务器地址" PlaceholderText="IP 或域名，如 47.108.135.204" />
                    <TextBox
                        x:Name="PortBox"
                        Grid.Column="1"
                        Header="服务器端口"
                        PlaceholderText="如 1080"
                        Text="1080" />
                </Grid>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UserBox" Header="用户名（可空）" PlaceholderText="服务器端 gost 设置的用户名" />
                    <PasswordBox x:Name="PassBox" Grid.Column="1" Header="密码（可空）" />
                </Grid>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LocalPortBox" Header="本地端口" Text="1080" />
                    <CheckBox
                        x:Name="TlsCheck"
                        Grid.Column="1"
                        Content="TLS 加密"
                        IsChecked="True"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8" />
                    <CheckBox
                        x:Name="SkipCertCheck"
                        Grid.Column="2"
                        Content="忽略服务器证书错误（自签证书时开启）"
                        IsChecked="True"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 操作行 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <Button x:Name="ToggleBtn" Content="一键开启代理" Click="ToggleBtn_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="TestBtn" Content="测试连接" Click="TestBtn_Click" />
            <ProgressRing
                x:Name="BusyRing"
                Width="20"
                Height="20"
                IsActive="False"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 服务器部署说明 -->
        <Border
            Grid.Row="3"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="8">
                <TextBlock Text="服务器端部署（gost，单文件，一分钟搞定）" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="1. 在服务器（Linux）下载 gost 并解压；2. 用下方命令启动；3. 在工具里填服务器地址/端口/账号密码，点「一键开启代理」。明文方式（端口建议 1080）：" />
                <TextBox
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    FontFamily="Consolas"
                    FontSize="12"
                    Text="gost -L socks5://user:pass@:1080"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="TLS 加密方式（推荐，证书可用证书申请功能签发的 fullchain.pem + privkey.pem；gost 需要 PEM 格式）：" />
                <TextBox
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    FontFamily="Consolas"
                    FontSize="12"
                    Text="gost -L socks5+tls://user:pass@:1080?cert=/path/fullchain.pem&amp;key=/path/privkey.pem"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="电脑 + 手机同时接入：同一命令再开一个 HTTP 代理端口（手机 Wi-Fi 原生代理只支持 HTTP，不支持 SOCKS5）：" />
                <TextBox
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    FontFamily="Consolas"
                    FontSize="12"
                    Text="gost -L socks5://user:pass@:1080 -L http://user:pass@:8080"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    Text="手机接入（两种方式，任选其一）：A. 免装 App——手机 Wi-Fi 设置 → 代理 → 手动：服务器填服务器公网地址，端口填 8080，账号密码与 gost 一致，HTTP/HTTPS 流量即走服务器出口。B. VPN 开关体验——手机装 Clash / Shadowrocket / SagerNet 等代理客户端，添加服务器（协议选 SOCKS5 或 HTTP + 账号密码），一键开启。注意：服务器防火墙需同时放行 1080 和 8080 端口；跨境网络代理请用于合法用途并遵守所在地区网络管理法规。" />
            </StackPanel>
        </Border>

        <!-- IKEv2 VPN（电脑端一键，手机端系统 IKEv2 填同样信息） -->
        <Border
            Grid.Row="4"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="10">
                <TextBlock Text="IKEv2 VPN（电脑 / 手机全流量直连）" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="服务器端部署 strongSwan（IKEv2）后：电脑点「连接」自动创建 Windows 系统 VPN 并连上（创建需管理员）；手机在 iOS 设置 → VPN → IKEv2 填同样的服务器地址和账号密码即可，两端全流量走服务器出口。" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="VpnServerBox" Header="VPN 服务器地址" PlaceholderText="服务器公网 IP 或域名" />
                    <TextBox
                        x:Name="VpnUserBox"
                        Grid.Column="1"
                        Header="用户名"
                        PlaceholderText="ipsec.secrets 里的账号" />
                </Grid>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="VpnPassBox" Header="密码" />
                    <Button
                        x:Name="VpnConnectBtn"
                        Grid.Column="1"
                        Content="连接"
                        Click="VpnConnectBtn_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8" />
                    <Button
                        x:Name="VpnDisconnectBtn"
                        Grid.Column="2"
                        Content="断开"
                        Click="VpnDisconnectBtn_Click"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8" />
                </Grid>
                <TextBlock
                    x:Name="VpnStatusText"
                    Text="未连接"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 日志 -->
        <Border
            Grid.Row="5"
            MaxHeight="240"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock
                    x:Name="LogText"
                    IsTextSelectionEnabled="True"
                    FontFamily="Consolas"
                    FontSize="12"
                    LineHeight="18"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </Grid>
    </ScrollViewer>

    </ScrollViewer>
</Page>
<Page
    x:Class="DesktopTool.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DesktopTool.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="ListItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="CardCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">


    

    <Grid Padding="24,16,24,16" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />

        <ScrollViewer Grid.Row="1">
            <StackPanel>

                <!-- 账号卡片 - 未登录 -->
                <Border x:Name="NotLoggedInCard" Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="64" Height="64" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#FF3A3A3A" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="20,0,0,0">
                            <TextBlock Text="未登录" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="登录以同步配置与数据" Style="{StaticResource CardCaptionStyle}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="登录" Click="GoLoginBtn_Click" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 账号卡片 - 已登录 -->
                <Border x:Name="LoggedInCard" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="80" Height="80" Background="Transparent" Tapped="Avatar_Tapped">
                            <Ellipse Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="UsernameText" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="UserIdText" Style="{StaticResource CardCaptionStyle}" />
                            <TextBlock Text="点击头像可更换" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 设置项列表 -->
                <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />

                <!-- 服务器设置 -->
                <Border Style="{StaticResource ListItemBorderStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="服务器地址" FontSize="14" FontWeight="SemiBold" />
                            <TextBox x:Name="ServerUrlBox" PlaceholderText="http://127.0.0.1:5000" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="保存" Click="SaveServerBtn_Click" />
                                <TextBlock x:Name="ServerStatus" Style="{StaticResource CardCaptionStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 开机自启 -->
                <Border Style="{StaticResource ListItemBorderStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7B4;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="开机自启" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="AutoStartStatus" Text="检测中…" Style="{StaticResource CardCaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            x:Name="AutoStartToggle"
                            VerticalAlignment="Center"
                            OnContent=""
                            OffContent=""
                            Toggled="AutoStartToggle_Toggled" />
                    </Grid>
                </Border>

                <!-- 退出登录（仅已登录显示） -->
                <Border x:Name="LogoutItem" Style="{StaticResource ListItemBorderStyle}" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE77B;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="退出登录" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="清除本地登录信息" Style="{StaticResource CardCaptionStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="退出" Click="LogoutBtn_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

    </ScrollViewer>
</Page>
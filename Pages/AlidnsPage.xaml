<Page
    x:Class="DesktopTool.Pages.AlidnsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <SolidColorBrush x:Key="AlidnsInfoBrush" Color="#7A7A7A" />
        <SolidColorBrush x:Key="AlidnsOkBrush" Color="#0F7B0F" />
        <SolidColorBrush x:Key="AlidnsErrorBrush" Color="#D13438" />
    </Page.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">


    

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="域名管理" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="支持阿里云云解析 与 Cloudflare 两家服务商，管理 DNS 解析记录（增删改查）。凭证保存在本机 Windows 凭据管理器，不上云。"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- 服务商选择 -->
            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="DNS 服务商" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="DnsProviderCombo" MinWidth="240" SelectionChanged="DnsProviderCombo_SelectionChanged">
                        <ComboBoxItem Content="阿里云云解析" Tag="alidns" IsSelected="True" />
                        <ComboBoxItem Content="Cloudflare" Tag="cloudflare" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 阿里云凭证 -->
            <Border
                x:Name="AkCredPanel"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="阿里云 AccessKey" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="需要子账号 AccessKey：RAM 访问控制中创建，授权 AliyunDNSFullAccess（或 AliyunDNSReadOnlyAccess + 手动开通）。" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AkIdBox" Header="AccessKey ID" PlaceholderText="LTAI..." />
                        <PasswordBox x:Name="AkSecretBox" Grid.Column="1" Header="AccessKey Secret" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存 AccessKey" Click="SaveAkBtn_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Cloudflare 凭证 -->
            <Border
                x:Name="CfCredPanel"
                Visibility="Collapsed"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="Cloudflare API Token" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="在 Cloudflare 仪表盘 → My Profile → API Tokens 创建，权限建议最小化：Zone.Zone（Read）+ Zone.DNS（Edit），Zone 选 All zones 或指定域名。" />
                    <PasswordBox x:Name="CfTokenBox" Header="API Token" PlaceholderText="粘贴 Token" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存 Token" Click="SaveTokenBtn_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 域名选择 -->
            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="选择域名" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,6" />
                            <ComboBox x:Name="DomainCombo" MinWidth="260" PlaceholderText="请先加载域名" SelectionChanged="DomainCombo_SelectionChanged" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="加载域名" Click="LoadDomainsBtn_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock
                        x:Name="DomainHintText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="选中域名后下方显示其全部解析记录。" />
                </StackPanel>
            </Border>

            <!-- 解析记录 -->
            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="解析记录" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <Button Content="刷新" Click="RefreshRecordsBtn_Click" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="添加记录" Click="AddRecordBtn_Click" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <ListView x:Name="RecordList" MaxHeight="480" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border
                                            Padding="6,2"
                                            CornerRadius="4"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{Binding Rr}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Value}" FontSize="13" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="TTL " /><Run Text="{Binding Ttl}" /><Run Text=" · 线路 " /><Run Text="{Binding Line}" /><Run Text=" · 状态 " /><Run Text="{Binding Status}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Content="编辑" Click="EditRecordBtn_Click" />
                                        <Button Content="删除" Click="DeleteRecordBtn_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="RecordEmptyText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="暂无记录。" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

    </ScrollViewer>
</Page>
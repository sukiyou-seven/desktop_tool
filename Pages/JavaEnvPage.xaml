<Page
    x:Class="DesktopTool.Pages.JavaEnvPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DesktopTool.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="CardCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">


    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="24,16,24,0" Spacing="2">
            <TextBlock Text="Java 环境" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="本机的 JDK、构建工具与项目管理" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <SelectorBar Grid.Row="1" Margin="24,14,24,0" x:Name="PageSelectorBar" SelectionChanged="PageSelectorBar_SelectionChanged">
            <SelectorBarItem Text="概览" Tag="overview" IsSelected="True" />
            <SelectorBarItem Text="工具链" Tag="toolchain" />
            <SelectorBarItem Text="包管理" Tag="packages" />
            <SelectorBarItem Text="新建项目" Tag="newproject" />
        </SelectorBar>

        <Grid Grid.Row="2" Margin="24,12,24,16">
            <ScrollViewer x:Name="OverviewPanel">
                <StackPanel Spacing="16" Padding="0,8,0,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="java" Style="{StaticResource CardCaptionStyle}" />
                                <TextBlock x:Name="JavaVersionText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="javac" Style="{StaticResource CardCaptionStyle}" />
                                <TextBlock x:Name="JavacVersionText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="JAVA_HOME" Style="{StaticResource CardCaptionStyle}" />
                                <TextBlock x:Name="JavaHomeText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="一键设置 JAVA_HOME + PATH" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="JdkCombo" PlaceholderText="选择一个 JDK" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Content="设置" Click="SetJavaHomeBtn_Click" />
                                <Button Grid.Column="2" Content="移除" Click="RemoveJavaHomeBtn_Click" />
                            </Grid>
                            <TextBlock x:Name="JavaStatusText" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ToolchainPanel" Visibility="Collapsed">
                <StackPanel Spacing="16" Padding="0,8,0,8">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="JDK 版本（Temurin / Adoptium）" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="JdkSearchBox" PlaceholderText="搜索版本（如 21）" Width="200" TextChanged="JdkSearchBox_TextChanged" />
                                <Button Content="刷新列表" Click="RefreshJdksBtn_Click" />
                            </StackPanel>
                            <TextBlock x:Name="JdkStatusText" Style="{StaticResource CardCaptionStyle}" />
                            <ListView x:Name="JdkList" SelectionMode="None" MaxHeight="400">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:JdkVersionItem">
                                        <Grid ColumnSpacing="12" Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Version}" Style="{StaticResource BodyStrongTextBlockStyle}" MinWidth="80" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Kind}" Style="{StaticResource CardCaptionStyle}" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                <Button Content="安装" Click="InstallJdkBtn_Click" Tag="{x:Bind}" Visibility="{x:Bind InstallBtnVisibility}" />
                                                <Button Content="卸载" Click="UninstallJdkBtn_Click" Tag="{x:Bind}" Visibility="{x:Bind UninstallBtnVisibility}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PackagesPanel" Visibility="Collapsed">
                <StackPanel Spacing="16" Padding="0,8,0,8">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="项目目录（含 pom.xml 或 build.gradle）" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="PkgProjectBox" PlaceholderText="选择项目目录" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="…" Click="PkgPickDirBtn_Click" Padding="10,4" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="mvn install" Click="MvnInstallBtn_Click" />
                                <Button Content="gradle build" Click="GradleBuildBtn_Click" />
                                <Button Content="刷新依赖" Click="RefreshDepsBtn_Click" />
                            </StackPanel>
                            <TextBlock x:Name="PkgStatusText" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" />
                            <ListView x:Name="DepList" SelectionMode="None" MaxHeight="300">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:JavaDepItem">
                                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" Padding="0,4" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="NewProjectPanel" Visibility="Collapsed">
                <StackPanel Spacing="16" Padding="0,8,0,8">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="新建 Java 项目" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBox x:Name="NewProjNameBox" Header="项目名称（groupId.artifactId，如 com.example.demo）" PlaceholderText="com.example.demo" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="NewProjDirBox" Header="存储目录" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="…" Click="NewProjPickDirBtn_Click" VerticalAlignment="Bottom" Padding="10,4" />
                            </Grid>
                            <ComboBox x:Name="NewProjBuildCombo" Header="构建工具">
                                <ComboBoxItem Content="Maven" IsSelected="True" />
                                <ComboBoxItem Content="Gradle" />
                                <ComboBoxItem Content="纯目录" />
                            </ComboBox>
                            <Button Content="创建项目" Click="CreateProjectBtn_Click" HorizontalAlignment="Left" />
                            <TextBlock x:Name="NewProjStatusText" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

    </ScrollViewer>
</Page>
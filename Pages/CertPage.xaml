<Page
    x:Class="DesktopTool.Pages.CertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <SolidColorBrush x:Key="StatusInfoBrush" Color="#7A7A7A" />
        <SolidColorBrush x:Key="StatusErrorBrush" Color="#D13438" />
    </Page.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">


    

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 说明 -->
        <StackPanel Spacing="4">
            <TextBlock Text="证书申请" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="使用 Let's Encrypt（ACME v2）申请免费 SSL 证书，支持阿里云 / Cloudflare DNS 自动验证（一键申请）与手动添加 DNS 记录两种方式，无需服务器公网访问、无需 certbot / Python 环境。全程在本地完成。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 模式切换 -->
        <SelectorBar Grid.Row="1" x:Name="ModeBar" SelectionChanged="ModeBar_SelectionChanged">
            <SelectorBarItem Text="DNS 自动申请（一键）" IsSelected="True" />
            <SelectorBarItem Text="手动申请（DNS）" />
        </SelectorBar>

        <!-- 配置卡片（两种模式共用） -->
        <Border
            Grid.Row="2"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="DomainBox"
                        Header="域名"
                        PlaceholderText="例如 server.example.com 或 *.example.com" />
                    <TextBox
                        x:Name="EmailBox"
                        Grid.Column="1"
                        Header="邮箱"
                        PlaceholderText="用于 ACME 账户与证书过期提醒" />
                </Grid>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CaCombo" Header="证书颁发机构" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Let's Encrypt（正式）" Tag="letsencrypt" IsSelected="True" />
                        <ComboBoxItem Content="Let's Encrypt（暂存 / 测试）" Tag="letsencrypt_staging" />
                    </ComboBox>
                    <ComboBox
                        x:Name="KeyCombo"
                        Grid.Column="1"
                        Header="证书密钥算法"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="ECDSA P-256（推荐）" Tag="ecdsa" IsSelected="True" />
                        <ComboBoxItem Content="RSA 2048" Tag="rsa" />
                    </ComboBox>
                </Grid>
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    Text="需要能修改该域名的 DNS 解析（添加 TXT 记录）。正式环境有配额限制（每域每周约 5 张），首次使用建议先选「暂存 / 测试」环境验证流程。" />
            </StackPanel>
        </Border>

        <!-- 自动模式（一键申请） -->
        <Border
            x:Name="AutoPanel"
            Grid.Row="3"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="10">
                <TextBlock Text="DNS 自动验证（一键申请）" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox
                    x:Name="DnsProviderCombo"
                    Header="DNS 服务商"
                    HorizontalAlignment="Left"
                    MinWidth="220"
                    SelectionChanged="DnsProviderCombo_SelectionChanged">
                    <ComboBoxItem Content="阿里云云解析" Tag="alidns" IsSelected="True" />
                    <ComboBoxItem Content="Cloudflare" Tag="cloudflare" />
                </ComboBox>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="AkIdBox"
                        Header="AccessKey ID"
                        PlaceholderText="阿里云 AccessKey ID" />
                    <PasswordBox
                        x:Name="AkSecretBox"
                        Grid.Column="1"
                        Header="AccessKey Secret" />
                </Grid>
                <PasswordBox
                    x:Name="CfTokenBox"
                    Visibility="Collapsed"
                    Header="Cloudflare API Token"
                    PlaceholderText="自动带出「域名管理」保存的 Token；如无请粘贴（Zone.DNS Edit 权限）" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="AutoRunBtn" Content="一键申请（自动添加 / 验证 / 清理 DNS）" Click="AutoRunBtn_Click" />
                </StackPanel>
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    Text="自动在 DNS 服务商处为 _acme-challenge 添加 TXT 验证记录、等待生效、提交验证并签发证书，完成后自动删除验证记录。阿里云：域名 NS 需托管在阿里云；Cloudflare：API Token 需具备 Zone.DNS Edit 权限。凭证自动复用「域名管理」页已保存的配置，无需重复填写。" />
            </StackPanel>
        </Border>

        <!-- 手动模式（操作按钮） -->
        <Grid
            x:Name="ManualPanel"
            Grid.Row="4"
            Visibility="Collapsed"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="Step1Btn" Content="第一步：获取 DNS 验证记录" Click="Step1Btn_Click" />
                <Button
                    x:Name="CheckDnsBtn"
                    Content="检查 DNS 是否生效"
                    Click="CheckDnsBtn_Click"
                    IsEnabled="False" />
                <Button
                    x:Name="Step2Btn"
                    Content="第二步：验证并签发证书"
                    Click="Step2Btn_Click"
                    IsEnabled="False" />
                <Button x:Name="ResetBtn" Content="重置" Click="ResetBtn_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <!-- 手动模式（TXT 记录卡片） -->
        <Border
            x:Name="TxtCard"
            Grid.Row="5"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock Text="请到 DNS 服务商（或域名注册商控制台）添加以下 TXT 记录" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="主机记录 (Name)" VerticalAlignment="Center" />
                    <TextBox x:Name="RecordNameBox" Grid.Column="1" IsReadOnly="True" IsSpellCheckEnabled="False" />
                    <Button x:Name="CopyNameBtn" Grid.Column="2" Content="复制" Click="CopyNameBtn_Click" />
                </Grid>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="记录值 (Value)" VerticalAlignment="Center" />
                    <TextBox x:Name="RecordValueBox" Grid.Column="1" IsReadOnly="True" IsSpellCheckEnabled="False" />
                    <Button x:Name="CopyValueBtn" Grid.Column="2" Content="复制" Click="CopyValueBtn_Click" />
                </Grid>
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    Text="记录类型 (Type)：TXT。添加后一般几分钟内生效（受 DNS TTL 影响）。生效后可点「检查 DNS 是否生效」确认，再执行第二步。" />
            </StackPanel>
        </Border>

        <!-- 状态行（共用） -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10">
            <ProgressRing
                x:Name="BusyRing"
                Width="20"
                Height="20"
                IsActive="False"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 已存在的证书（续期 / 管理） -->
        <Border
            x:Name="InstalledCard"
            Grid.Row="7"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock Text="已存在的证书（可续期）" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ListView
                    x:Name="InstalledList"
                    MaxHeight="240"
                    SelectionMode="None"
                    IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Domain}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Content="续期"
                                    Padding="10,4"
                                    FontSize="12"
                                    Tag="{Binding}"
                                    Click="RenewCertBtn_Click" />
                                <Button
                                    Grid.Column="2"
                                    Content="打开目录"
                                    Padding="10,4"
                                    FontSize="12"
                                    Tag="{Binding}"
                                    Click="OpenInstalledDirBtn_Click" />
                                <Button
                                    Grid.Column="3"
                                    Content="删除"
                                    Padding="10,4"
                                    FontSize="12"
                                    Tag="{Binding}"
                                    Click="DeleteCertBtn_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="InstalledEmptyText"
                    Text="暂无已签发证书。申请成功后会自动出现在这里，可随时一键续期。"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 结果卡片（共用） -->
        <Border
            x:Name="ResultCard"
            Grid.Row="8"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock
                    x:Name="ResultTitle"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                <TextBlock
                    x:Name="ResultPathText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <Button x:Name="OpenDirBtn" Content="打开证书目录" Click="OpenDirBtn_Click" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <!-- 日志（共用） -->
        <Border
            Grid.Row="9"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock
                    x:Name="LogText"
                    IsTextSelectionEnabled="True"
                    FontFamily="Consolas"
                    FontSize="12"
                    LineHeight="18"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </Grid>

    </ScrollViewer>
</Page>
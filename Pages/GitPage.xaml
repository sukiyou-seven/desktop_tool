<Page
    x:Class="DesktopTool.Pages.GitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">


    <Grid Padding="24,16,24,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 说明 -->
        <StackPanel Spacing="4">
            <TextBlock Text="Git 设置" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="登录 GitHub / Gitee 管理私有仓库。凭据保存到 Windows 凭据管理器，git 命令行可直接复用，即使本软件关闭或卸载仍然有效"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 平台选择 -->
        <SelectorBar
            Grid.Row="1"
            x:Name="PlatformBar"
            SelectionChanged="PlatformBar_SelectionChanged">
            <SelectorBarItem Text="GitHub" Tag="github" IsSelected="True" />
            <SelectorBarItem Text="Gitee" Tag="gitee" />
            <SelectorBarItem Text="自定义" Tag="custom" />
        </SelectorBar>

        <!-- 自定义仓库配置（仅自定义平台显示） -->
        <Border
            x:Name="CustomPanel"
            Grid.Row="2"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBox
                    x:Name="ServerUrlBox"
                    PlaceholderText="服务器地址，如 https://git.example.com 或 http://192.168.1.10:3000" />
                <ComboBox x:Name="ApiTypeCombo" Header="API 类型" MaxWidth="360" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Gitea / Gogs / Forgejo" Tag="gitea" />
                    <ComboBoxItem Content="GitLab" Tag="gitlab" />
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- 登录卡片 -->
        <Border
            Grid.Row="3"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox
                        x:Name="TokenBox"
                        Grid.Column="0"
                        PlaceholderText="输入 Personal Access Token（需 repo / projects 权限）"
                        PasswordChanged="TokenBox_PasswordChanged" />
                    <Button
                        x:Name="LoginBtn"
                        Grid.Column="1"
                        Content="登录并保存"
                        Click="LoginBtn_Click"
                        IsEnabled="False" />
                    <Button
                        x:Name="LogoutBtn"
                        Grid.Column="2"
                        Content="退出登录"
                        Click="LogoutBtn_Click"
                        Visibility="Collapsed" />
                </Grid>

                <TextBlock
                    x:Name="StatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    Text="GitHub：Settings → Developer settings → Personal access tokens；Gitee：设置 → 私人令牌。凭据将存入系统凭据管理器（目标名 git:https://&lt;host&gt;），git 克隆私有仓库时无需再次输入" />
            </StackPanel>
        </Border>

        <!-- 仓库列表 -->
        <Grid Grid.Row="4" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="我的仓库" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" VerticalAlignment="Center" />
                <Button x:Name="RefreshBtn" Content="刷新" Click="RefreshBtn_Click" />
                <TextBlock x:Name="RepoCountText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <ListView x:Name="RepoList" Grid.Row="1" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <Border
                                            VerticalAlignment="Center"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            Visibility="{Binding PrivateVisibility}">
                                            <TextBlock Text="私有" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Border>
                                        <TextBlock
                                            Text="{Binding Language}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Visibility="{Binding LangVisibility}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock
                                        Text="{Binding Description}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="2" />
                                    <TextBlock
                                        Text="{Binding MetaText}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        TextTrimming="CharacterEllipsis" />

                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                        <Button
                                            Content="分支"
                                            Tag="{Binding}"
                                            Click="BranchesBtn_Click"
                                            Padding="10,4"
                                            FontSize="12" />
                                        <TextBlock
                                            Text="{Binding BranchStatusText}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ItemsControl
                                        ItemsSource="{Binding Branches}"
                                        Visibility="{Binding BranchesVisibility}"
                                        Margin="0,2,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Content="{Binding BranchName}"
                                                    Tag="{Binding}"
                                                    Click="BranchBtn_Click"
                                                    Padding="10,4"
                                                    FontSize="12"
                                                    Margin="0,0,8,4"
                                                    ToolTipService.ToolTip="点击复制克隆命令（目录名：项目名_分支名）" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Content="复制克隆地址"
                                    Tag="{Binding}"
                                    Click="CopyUrlBtn_Click"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>

    </ScrollViewer>
</Page>
<Page
    x:Class="DesktopTool.Pages.DownloadPhpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DesktopTool.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">


    <Grid Padding="24,16,24,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 返回 + 说明 -->
        <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="BackBtn"
                    Click="BackBtn_Click"
                    Padding="10,6"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="返回 PHP 环境">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Text="下载安装 PHP" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock
                Text="从 PHP 官方源（downloads.php.net）下载 Windows 便携版（zip），解压到本工具托管目录，不修改系统 PATH"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 搜索 + 状态 + 刷新 -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="筛选版本，如 8.3、8.5…"
                TextChanged="SearchBox_TextChanged" />

            <TextBlock
                x:Name="PageStatusText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" VerticalAlignment="Center" />
                <Button x:Name="RefreshBtn" Content="刷新" Click="RefreshBtn_Click" />
            </StackPanel>
        </Grid>

        <!-- 版本列表 -->
        <ListView x:Name="VersionList" Grid.Row="2" SelectionMode="None" HorizontalAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DownloadUrl}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <ComboBox
                            Grid.Column="1"
                            MinWidth="160"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding Variants}"
                            SelectedItem="{Binding SelectedVariant, Mode=TwoWay}" />

                        <Border
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            CornerRadius="4"
                            Padding="6,1"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{Binding StatusVisibility}">
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>

                        <Button Grid.Column="3" Content="{Binding ButtonText}" Tag="{Binding}" Click="InstallBtn_Click" IsEnabled="{Binding NotBusy}" />
                        <Button
                            Grid.Column="4"
                            Content="卸载"
                            Tag="{Binding}"
                            Click="UninstallBtn_Click"
                            Visibility="{Binding StatusVisibility}"
                            IsEnabled="{Binding NotBusy}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 日志 -->
        <TextBox
            x:Name="LogBox"
            Grid.Row="3"
            IsReadOnly="True"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            Height="150"
            FontFamily="Consolas"
            FontSize="12"
            BorderThickness="1" />
    </Grid>

    </ScrollViewer>
</Page>